# Only these ambient variables reach crewmates, scouts, and secondmates.
# Claude login lives in the keychain, git uses the sops-provided key via
# core.sshCommand, so workers need very little from the environment.
GH_TOKEN
CLAUDE_CODE_OAUTH_TOKEN
FIGMA_TOKEN
SSH_AUTH_SOCK
# Infra access: kubernetes (KUBECONFIG points at the sops-provided hcloud
# config), hetzner/terraform, docker via colima, AWS/B2 object storage.
KUBECONFIG
HCLOUD_TOKEN
TF_VAR_hcloud_token
DOCKER_HOST
AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY
B2_APPLICATION_KEY_ID
B2_APPLICATION_KEY
