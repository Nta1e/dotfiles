{
  "model": "claude-opus-5-5",
  "enabledMcpjsonServers": ["mattermost"],
  "permissions": {
    "defaultMode": "default",
    "additionalDirectories": ["~/workspace/odoo", "~/dotfiles/home/hermes/ops"],
    "allow": [
      "mcp__mattermost__reply",
      "mcp__mattermost__dm",
      "Bash(kubectl --context admin@kx-hcloud -n pg-odoo exec -i odoo-prod-2 -c postgres -- psql:*)",
      "Bash(kubectl --context admin@kx-hcloud -n pg-apps exec -i apps-2 -c postgres -- psql:*)",
      "Bash(kubectl --context admin@kx-hcloud -n pg-odoo get pods:*)",
      "Bash(kx wallets:*)",
      "Bash(kx equity status:*)",
      "Bash(kx equity import:*)",
      "Bash(kx equity open:*)",
      "Bash(kx equity book:*)",
      "Bash(kx equity set-closing:*)",
      "Bash(pdftotext:*)",
      "Read",
      "Grep",
      "Glob",
      "Edit(./out/**)"
    ],
    "deny": [
      "Bash(kubectl delete:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl edit:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl rollout:*)",
      "Bash(git push:*)",
      "Read(~/.config/sops-nix/**)",
      "Read(~/.hermes/env*)",
      "Read(~/.kube/**)"
    ]
  }
}
